# En desarrollo, React buscará este valor en process.env.REACT_APP_API_URL
REACT_APP_API_URL=http://localhost:8080/api/auth

# que el servidor escuche en todas las interfaces
HOST=0.0.0.0

# Configuración explícita del WebSocket client
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws
WDS_SOCKET_PROTOCOL=ws

# Para que detecte cambios en volúmenes montados:
CHOKIDAR_USEPOLLING=true
